# PostgreSQL connection
DATABASE_URL=postgresql://user:password@localhost:5432/opros

# Пароль для входа в админку (POST /api/auth/login)
ADMIN_PASSWORD=your-admin-password

# JWT secret (для подписи токенов авторизации)
JWT_SECRET=your-jwt-secret-change-me

# Supabase: JWT Secret (Settings → API), для проверки access_token после Google/Microsoft OAuth
# Без этого OAuth-пользователи получат 401 от API.
SUPABASE_JWT_SECRET=

# Через запятую: email → автоматически is_global_admin в таблице profiles при синхронизации
GLOBAL_ADMIN_EMAILS=

# Статичный API key (обратная совместимость, опционально)
ADMIN_API_KEY=your-secret-admin-key-here

# Telegram уведомления
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Публичный URL сервера (для формирования ссылок на загруженные файлы)
PUBLIC_URL=http://localhost:3001

# Директория для загруженных файлов (по умолчанию: ./uploads)
# UPLOAD_DIR=/var/data/uploads

# URL фронтенда для CORS. Несколько через запятую: http://localhost:5173,https://prod.example
# Если не задан и NODE_ENV не production — сервер отражает Origin (удобно для любого порта Vite).
# Если задан только прод-URL, а вы открываете http://localhost:5173 — браузер заблокирует API (CORS).
# FRONTEND_URL=http://localhost:5173
# FRONTEND_URL=https://your-domain.com

# Порт сервера
PORT=3001

# Уровень логирования: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
