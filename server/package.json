{
  "name": "askly-api",
  "version": "0.1.0",
  "description": "Backend API for Askly — ready for self-hosting",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run build && npm test && npm run build:edge",
    "test:integration": "node --import tsx scripts/test-database.mjs",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "build:edge": "node scripts/build-edge.mjs",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "jose": "^5.10.0",
    "pg": "^8.13.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
