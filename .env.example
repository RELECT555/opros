# Скопируй в .env и заполни значения
# cp .env.example .env

# PostgreSQL пароль
POSTGRES_PASSWORD=changeme_strong_password

# Секретный ключ для API (придумай длинный случайный)
ADMIN_API_KEY=your-very-long-secret-key-here

# URL фронтенда (для CORS)
FRONTEND_URL=https://your-domain.com

# Telegram (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
