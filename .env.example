# Скопируй в .env и заполни значения
# cp .env.example .env

# PostgreSQL пароль
POSTGRES_PASSWORD=changeme_strong_password

# Пароль администратора и отдельный секрет подписи JWT (минимум 32 символа)
ADMIN_PASSWORD=
JWT_SECRET=

# OAuth (опционально; тот же проект Supabase, что у фронтенда)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# URL фронтенда (для CORS)
FRONTEND_URL=https://your-domain.com

# Telegram (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
