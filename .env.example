# Скопируй в .env и заполни значения
# cp .env.example .env

# PostgreSQL: отдельный случайный пароль. Для URL используйте hex/base64url-символы.
# Порт БД не публикуется на хост; API подключается по внутренней сети Compose.
POSTGRES_PASSWORD=

# Пароль администратора и отдельный секрет подписи JWT (минимум 32 символа)
ADMIN_PASSWORD=
JWT_SECRET=

# OAuth (опционально; тот же проект Supabase, что у фронтенда)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# URL фронтенда (для CORS)
FRONTEND_URL=https://your-domain.com

# Telegram (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
